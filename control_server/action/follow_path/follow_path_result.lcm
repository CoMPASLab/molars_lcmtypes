package control_server.action.follow_path;

struct follow_path_result
{
    // Error codes. Note: The expected priority order of the errors should match the message order
    const int16_t NONE                      = 0,
                  UNKNOWN                   = 100,
                  INVALID_CONTROLLER        = 101,
                  TF_ERROR                  = 102,
                  INVALID_PATH              = 103,
                  PATIENCE_EXCEEDED         = 104,
                  FAILED_TO_MAKE_PROGRESS   = 105,
                  NO_VALID_CONTROL          = 106;

    int16_t error_code;
    string error_msg;
}
